APP_NAME="BD Ride Share API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_ride_share
# Docker compose defaults (infra/docker/docker-compose.yml): user bdride / pass bdride
DB_USERNAME=bdride
DB_PASSWORD=bdride

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

JWT_SECRET=
JWT_TTL=15

PUSHER_APP_ID=local
PUSHER_APP_KEY=local-key
PUSHER_APP_SECRET=local-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

GOOGLE_MAPS_API_KEY=

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ---------------------------------------------------------------
# SMS Gateway (Phase 0a)
# ---------------------------------------------------------------
# Default driver: "null" (local/test) or "ssl_wireless"
SMS_DEFAULT_PROVIDER=null

# SSL Wireless � bdride SMS provider
SMS_PROVIDERS_SSL_WIRELESS_SID=
SMS_PROVIDERS_SSL_WIRELESS_TOKEN=
SMS_PROVIDERS_SSL_WIRELESS_MASKING=
SMS_PROVIDERS_SSL_WIRELESS_BASE_URL=https://api.sslwireless.com
SMS_PROVIDERS_SSL_WIRELESS_TIMEOUT=10

# OTP rate limit (per-phone, per-IP) � both checked, lower trips first
OTP_RATE_LIMIT_PHONE=3
OTP_RATE_LIMIT_IP=10

# ------------------------------------------------------------------
# Phase 0b — Mobile-banking payment gateway
# ------------------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER=null

# bKash Tokenized v1.2
PAYMENT_PROVIDERS_BKASH_USERNAME=
PAYMENT_PROVIDERS_BKASH_PASSWORD=
PAYMENT_PROVIDERS_BKASH_APP_KEY=
PAYMENT_PROVIDERS_BKASH_APP_SECRET=
PAYMENT_PROVIDERS_BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
PAYMENT_PROVIDERS_BKASH_TIMEOUT=15

# Nagad DCB
PAYMENT_PROVIDERS_NAGAD_MERCHANT_ID=
PAYMENT_PROVIDERS_NAGAD_MERCHANT_KEY=
PAYMENT_PROVIDERS_NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
PAYMENT_PROVIDERS_NAGAD_TIMEOUT=15

# ------------------------------------------------------------------
# Phase 0b — Firebase Cloud Messaging
# ------------------------------------------------------------------
FCM_DEFAULT_PROVIDER=null
FCM_PROVIDERS_FIREBASE_PROJECT_ID=
FCM_PROVIDERS_FIREBASE_CREDENTIALS_PATH=
FCM_PROVIDERS_FIREBASE_TIMEOUT=10

# === Phase 0c — broadcast / WebSocket ===
#
# BROADCAST_DRIVER picks the connection that ShouldBroadcast events go through.
#   null  — drops all events (used by unit tests)
#   log   — writes payloads to storage/logs/laravel.log (dev default)
#   redis — uses Redis pub/sub; useful for a separate WS worker
#   pusher — hosted pusher.com OR self-hosted Soketi (pusher-compatible)
#   reverb — Laravel's first-party WebSocket broker (requires PHP 8.2+)
BROADCAST_DRIVER=log

# Pusher (works with pusher.com or self-hosted Soketi). Optional when
# BROADCAST_DRIVER != pusher.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Laravel Reverb — Phase 0c-pre-wired, active once composer install lands
# (requires PHP 8.2+). Leave blank in dev until the api base image is
# bumped; the default `log` driver above already lets us verify event
# payloads without a broker.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_TLS_VERIFY=true