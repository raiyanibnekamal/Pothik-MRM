APP_NAME="BD Ride Share API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_ride_share
# Docker compose defaults (infra/docker/docker-compose.yml): user bdride / pass bdride
DB_USERNAME=bdride
DB_PASSWORD=bdride

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

JWT_SECRET=
JWT_TTL=15

PUSHER_APP_ID=local
PUSHER_APP_KEY=local-key
PUSHER_APP_SECRET=local-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

GOOGLE_MAPS_API_KEY=

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
